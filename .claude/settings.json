{
  "model": "opusplan",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Agent"
    ]
  },
  "compactPrompt": "Durable rules:\n- TWO .claude/ dirs exist: ./.claude/ (working ON the meta-system) and ./template/.claude/ (gets installed INTO target projects). Never conflate.\n- Template files use .template suffix. Don't edit them as live config.\n- Non-destructive install: code that touches a target project's .claude/ must merge, never overwrite.\n- Plan before structural changes. This project is the foundation other projects inherit.\n- Verify file existence before recommending a path or command.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/precompact-backup.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-bash-safety.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sessionstart-rules.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/cruft-check.sh\" --hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sessionend-observe.sh\""
          }
        ]
      }
    ]
  }
}
