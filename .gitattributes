# Cross-platform line-ending consistency: enforce LF on all text files.
# Overrides core.autocrlf=true on Windows to prevent CRLF drift in worktree
# that would otherwise produce SHA-256-distinct content for byte-identical
# files (Phase 32c closure of Phase 32a TEMPLATE_UPDATED FPs).
* text=auto eol=lf

# Force LF endings for shell scripts on all platforms.
# Bash will not execute a script whose shebang line ends in CRLF.
*.sh text eol=lf
*.bash text eol=lf

# Force LF for skill / hook markdown that ships executable behavior.
template/.claude/hooks/**/*.md text eol=lf
template/.claude/scripts/**/*.md text eol=lf
