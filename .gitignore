# Dependencies
node_modules/

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# Logs
*.log

# Claude Code session-local state (per Trainer-View convention)
.claude/agent-memory/

# Claude Code per-user/per-machine local config (permission allowlists, etc.)
.claude/*.local.json

# Test projects (used for install validation in Phase 4d-e)
/test-projects/

# Runtime observation files (written by session-observer / task-watchdog /
# cruft-checker). Persistent on disk for cross-session workflow-suggester
# consumption, but not part of source-of-truth repo state.
.claude/observations/*.json
.claude/observations/.session-ended
# The watchdog marker lives under observations/ (task-watchdog.sh OBS_DIR);
# the old .claude/-root path here never matched anything — invisible until
# Phase 57 made the script actually write the marker.
.claude/observations/.last-watchdog-session
.claude/.last-cruft-check
.claude/.last-plugin-quality-check

# Hook runtime artifacts — per-session noise, not release narrative.
docs/SESSION_LOG.md

# Phase 46 telemetry: per-session JSONL + markdown rollups are
# per-install local data, not source-of-truth. The canonical cross-install
# summary lives at .claude/observations/token-telemetry-<id>.json which is
# already gitignored via .claude/observations/*.json above. .gitkeep + README
# in each telemetry subdir stay tracked.
.claude/telemetry/events/*.jsonl
.claude/telemetry/sessions/*.md

# Phase 53 optimizer runtime: the sessions-since-last-run counter mutates at
# every SessionEnd, and staged draft proposals are transient (folded into
# their ledger at the seam) — runtime state, not source-of-truth. The
# tracked ledger seeds (retier-proposals.json, optimizer-proposals.json)
# stay in.
.claude/telemetry/optimizer-state.json
.claude/telemetry/*.draft.json

# Phase 47b shared-memory: the LOCAL staging tree of redacted cross-install
# events (producer/install/date). A plain mirror of the share remote's
# layout; Phase 47c clones the remote and pushes from it. Per-install runtime
# state, not source-of-truth — same rationale as observations/ + telemetry/.
.claude/shared-memory/

# Phase 47c-1 push layer: last successful push marker (timestamp + file count),
# surfaced by /share-status. Per-install runtime state, not source-of-truth.
.claude/.last-shared-push
